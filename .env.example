# Settings for docker-compose. Copy to .env and change every value.
POSTGRES_PASSWORD=change-me-db-password
# Long random string, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Password for all demo accounts created by the seed
SEED_PASSWORD=Demo@12345

# Optional real email. Leave SMTP_HOST empty to print emails in the backend logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Service Desk <service@example.com>"
