# Copy to .env and fill in. Never commit .env.
PORT=4000
NODE_ENV=development

# SQLite file for local dev. docker-compose overrides this with a Postgres URL.
DATABASE_URL="file:./dev.db"

# Use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

# Where the React app is served (used for CORS and QR code links)
FRONTEND_URL=http://localhost:5173

# Password given to every account created by `npm run seed` (demo only)
SEED_PASSWORD=Demo@12345

# Daily reminder job (node-cron). Default: 07:00 every day.
REMINDER_CRON="0 7 * * *"
REMINDER_TZ=Asia/Kolkata

# Email. Leave SMTP_HOST empty in development: emails are printed to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Service Desk <service@example.com>"

# Python ML service (product selector + parts forecast)
ML_SERVICE_URL=http://localhost:8000
